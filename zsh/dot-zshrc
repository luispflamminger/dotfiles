# Sourced in interactive shells only. Should contain commands to set up
# aliases, functions, options, key bindings, etc.

autoload -Uz compinit
compinit

### SHELL SETTINGS ###

# Shared history
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_FIND_NO_DUPS

# Colors
export CLICOLOR=1
zstyle ':completion:*:default' list-colors ''

# Default Editor
export EDITOR=nvim

# gpg commit signing
export GPG_TTY=$(tty)

### TOOLS ###

# node version manager (fnm), switches versions on cd if .node-version/.nvmrc exist
if command -v fnm &>/dev/null; then
  eval "$(fnm env --use-on-cd --shell zsh)"
fi

### ALIASES ###

# ls
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# grep
alias grep='grep --color=auto'

# fuzzy find repos
alias jd='cd $(find ~/dev -mindepth 1 -maxdepth 6 -type d 2>/dev/null | fzf)'

# git aliases
alias gs='git status'
alias gl='git log'

# open current git remote in the default browser
alias gof='open $(git remote -v | grep -o -E "https://git[^ ]*" | tail -1)'

### LOCAL OVERRIDES ###

# machine-specific settings and secrets, not tracked in this repo
if [ -f "$HOME/.zshrc.local" ]; then
  . "$HOME/.zshrc.local"
fi

### PROMPT ###

# launch starship
eval "$(starship init zsh)"
