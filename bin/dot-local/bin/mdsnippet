#!/bin/bash

# Publish a Markdown file as a personal GitLab snippet and print its URL.
mdsnippet() {
  local file title visibility url

  if [ $# -lt 1 ] || [ $# -gt 3 ]; then
    printf 'Usage: mdsnippet <file.md> [title] [private|internal|public] # default: internal\n' >&2
    return 2
  fi

  file=$1
  title=${2:-$(basename "$file")}
  visibility=${3:-internal}

  if [ ! -f "$file" ]; then
    printf 'mdsnippet: file not found: %s\n' "$file" >&2
    return 1
  fi

  case "$file" in
  *.md | *.markdown) ;;
  *)
    printf 'mdsnippet: expected a Markdown file (*.md or *.markdown): %s\n' "$file" >&2
    return 1
    ;;
  esac

  case "$visibility" in
  private | internal | public) ;;
  *)
    printf 'mdsnippet: invalid visibility: %s\n' "$visibility" >&2
    return 2
    ;;
  esac

  if ! command -v glab >/dev/null 2>&1; then
    printf 'mdsnippet: glab is not installed or not on PATH\n' >&2
    return 127
  fi

  url=$(glab snippet create --personal --title "$title" --filename "$(basename "$file")" --visibility "$visibility" "$file" | command grep -Eo 'https?://[^ ]+' | command tail -n 1)
  if [ -z "$url" ]; then
    printf 'mdsnippet: failed to create snippet\n' >&2
    return 1
  fi

  printf '%s\n' "$url"
}
